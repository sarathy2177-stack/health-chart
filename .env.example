# ===================================================
# BEN Healthcare Web Application - Self-Hosting Config
# ===================================================

# 1. PostgreSQL Database URL
# Options:
# - Local PostgreSQL: postgresql://postgres:your_password@localhost:5432/ben_health
# - Free Cloud PostgreSQL (e.g., Neon or Supabase): postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ben_health"

# 2. Base URL of the Application
# - For local testing only: http://localhost:3000
# - For Local Network (Wi-Fi/LAN) access: http://10.200.190.20:3000 (Replace with your server's LAN IP)
# - For domain / public self-hosting: https://yourdomain.com
BETTER_AUTH_URL="http://localhost:3000"

# 3. Secret Key for Session Encryption
# Generate any 32+ character random string or secret
BETTER_AUTH_SECRET="ben_healthcare_secure_session_secret_key_change_me_987654321"

# 4. Optional: Additional Trusted Origins (comma-separated)
# Useful if accessing from multiple IPs or local domain names:
# TRUSTED_ORIGINS="http://10.200.190.20:3000,http://127.0.0.1:3000"
